  "photoNotes": [
    {
      "frames": "1–9, 17, 57–59",
      "details": "Brick piers and blue entrance signage, adjoining white guard and guardian rooms with corrugated metal roofing, curved black-and-white garden curb, palms and flower beds. IMG_3142.JPG measures 10 ft 3 in at the blue front eave."
    },
    {
      "frames": "7, 10–20, 42–43, 53–56",
      "details": "Cream grid over dark red CSE lattice panels, blue roof fascia, salmon official wing with the Admission Office and first Academic gate, and the campus bus near the garden fork. IMG_3146.JPG shows the blue bus and measures 8 ft 11 in at the roofline."
    },
    {
      "frames": "19–32",
      "details": "Low off-white service row, washroom, mural panels, Bag Counter beside the CSE Library door, right-hand Law passage, Pharmacy Library on the way to the ground."
    },
    {
      "frames": "32–52, 60–68",
      "details": "Pink Academic facade along the ground with Gate 2, Medical Center and Student Welfare in sequence, white Civil block, red cafe, banyan and red-roofed shelter. The central lawn incorporates a marked court."
    },
    {
      "frames": "67–73",
      "details": "Pool beyond the playing ground, narrow deck, palms, and a blue shed. The submerged ring is a fictional addition."
    }
  ]
